extends layout/layout

block vars
    -title = 'Sản phẩm chi tiết' 
    -bodyClass = 'page-prod'

block container 
    +Popup("popup-write","comment")
        .wrapper 
            .tt Đánh giá sản phẩm
            +MiniCart2()
            form(action="")
                .popup-write__form.rating-review 
                    +Rate()
                    p.label Nội dung của bạn
                    .popup-write__box 
                        textarea(placeholder="Nội dung của bạn")
                        #previewContainer
                    label.rating-upload
                        span#dropArea
                            input#fileInput(
                                hidden="" 
                                multiple="" 
                                type="file"
                                )
                            .iwt 
                                .icon 
                                    +img("ic-photo.png")
                                p.txt Tải lên hình ảnh/video
                            span.btn-plus 
                                +img("ic-plus.svg")
                    +Btn("Gửi đánh giá","","pri full","ic-arrow.svg")
    +Popup("popup-ask","ask")
        .wrapper 
            .tt giải đáp câu hỏi
            form(action="")
                .popup-ask__form 
                    +Form
                        +FormIp("Tên của bạn","","Tên của bạn","col")
                        +FormIp("Số điện thoại","","Số điện thoại","col")
                        +FormIp("Email (Không bắt buộc)","","Email","col")
                        +FormIp("Tên của bạn","","Tên của bạn","col")
                        +FormArea("Nhập câu hỏi của bạn","","Nhập câu hỏi của bạn","col")
                        +FormWrap
                            +Btn("Gửi câu hỏi","","pri full","")
    +Popup("popup-dn","dn")
        .wrapper 
            .icon 
                +img("ic-pop-dn.svg")
            .tt Bạn cần đăng nhập để đánh giá sản phẩm nÀY
            +Btn("Đăng nhập ngay","","pri full","")

    section.sec-breadcrumb
        .container
            +BreadCrumb([{txt:"Sản phẩm"},{txt:"Tinh chất bí đao 70ml - Tặng dung dịch chấm mụn bí đao 5ml"}])
    section.sec-homes-smallbn 
        .homes-smallbn.ss-pd-min-t
            .container 
                .homes-smallbn__box 
                    .bg.frameJs 
                        +img("homes-small-bn1.jpg")
    section.sec-prod-dt
        .prod-dt.ss-pd-min-t 
            .container 
                .prod-dt__boxer
                    .prod-dt__flex.row 
                        .prod-dt__slide.col 
                            .wrapper 
                                .prod-dt__slide-main
