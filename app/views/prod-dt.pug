                                                            .cdw-inner 
                                                                .number.date
                                                                span.text Ngày
                                                        span.txt :
                                                        .cdw-item 
                                                            .cdw-inner 
                                                                .number.hour
                                                                span.text Giờ
                                                        span.txt :
                                                        .cdw-item 
                                                            .cdw-inner 
                                                                .number.minute
                                                                span.text Phút
                                                        span.txt :
                                                        .cdw-item
                                                            .cdw-inner 
                                                                .number.second
                                                                span.text Giây
                                    .prod-dt__desc 
                                        span.tt  Mô tả sản phẩm
                                        .mona-content 
                                            p Figma ipsum component variant main layer. Object horizontal auto asset pencil fill ellipse thumbnail outline connection. Shadow ipsum edit font rectangle select draft font pen figma. Mask scale text edit italic scrolling fill underline opacity. Figjam ipsum subtract plugin thumbnail distribute shadow undo. Blur link content reesizing figma ipsum effect main.

                                    .prod-dt__variant 
                                        span.tt  Phân loại sản phẩm
                                        .prod-dt__variant-list 
                                            label.prod-dt__variant-item 
                                                input(type="radio", name="variant", value="1")
                                                span.txt 300 Gram
                                            label.prod-dt__variant-item 
                                                input(type="radio", name="variant", value="1")
                                                span.txt 500 Gram
                                            label.prod-dt__variant-item 
                                                input(type="radio", name="variant", value="1")
                                                span.txt 800 Gram
                                            label.prod-dt__variant-item 
                                                input(type="radio", name="variant", value="1")
                                                span.txt 2 x 800 Gram
                                            label.prod-dt__variant-item 
                                                input(type="radio", name="variant", value="1")
                                                span.txt 2 x 500 Gram
                                    .prod-dt__km 
                                        .inner 
                                            .inner-head 
                                                .iwt 
                                                    .icon 
                                                        +img("ic-gifs.svg")
                                                    p.txt Khuyến mãi hấp dẫn
                                            .inner-content 
                                                ul 
                                                    li Figma ipsum component variant main layer. Object horizontal auto asset pencil fill ellipse thumbnail outline connection.
                                                    li Figma ipsum component variant main layer. Object horizontal auto asset pencil fill ellipse thumbnail outline connection.
                                    .prod-dt__action
                                        .flex.row  
                                            .col 
                                                +Count()
                                            .col 
                                                +Btn("Mua ngay","","second full")
                                            .col 
                                                a(href="").prod-dt__icon.prod-dt__cart
                                                    +img("ic-cart-black.svg")
                                            .col 
                                                a(href="").prod-dt__icon.prod-dt__heart
                                                    i.fa-regular.fa-heart  
                                    .prod-dt__view 
                                        .iwt 
                                            .icon 
                                                +img("ic-star-red.svg")
                                            .txt 
                                                span.txt-red Sản phẩm đang được chú ý, 
                                                |có 30 người thêm vào giỏ hàng & 20 người đang xem
                                    .prod-dt__feature
                                        .prod-dt__feature-list.row 
                                            .col
                                                .prod-dt__feature-item
                                                    .icon 
                                                        +img("ic-ft2.svg")
                                                    p.tit Miễn phí vận chuyển
                                                    span.txt theo chính sách giao hàng
                                            .col
                                                .prod-dt__feature-item
                                                    .icon 
                                                        +img("ic-ft4.svg")
                                                    p.tit Miễn phí vận chuyển
                                                    span.txt theo chính sách giao hàng
                                            .col
                                                .prod-dt__feature-item
                                                    .icon 
                                                        +img("ic-ft3.svg")
                                                    p.tit Miễn phí vận chuyển
                                                    span.txt theo chính sách giao hàng
                                            
