                                        .img-tag.new
                                            .iwt 
                                                .icon 
                                                    +img("ic-mini.svg")
                                                p.txt MỚi
                                        .img-tag.sale
                                            .iwt 
                                                .icon 
                                                    +img("ic-mini.svg")
                                                p.txt -22%
                                    .swiper
                                        .swiper-wrapper 
                                            each val,index in Array(10)
                                                .swiper-slide 
                                                    .img
