extends layout/layout

block vars
    -title = 'Giới thiệu' 
    -bodyClass = 'page-about'

block container 
    section.sec-breadcrumb
        .container
            +BreadCrumb([{txt:"Giới thiệu"}])
    section.sec-ab-first 
        .ab-first.ss-pd-min-t.add-class.ParaY  
            .sign__decs
                .sign__dec.ParaYScroll
                    .in 
                        +img("sign-dec1.png")
                .sign__dec.ParaYScroll
                    .in 
                        +img("dec-bohon.png")
            .container
                .ab-first__title 
                    p.sub(data-aos="fade-up-cus" data-aos-delay="300") Về chúng tôi
                    p.ttmsl(data-aos="fade-up-cus" data-aos-delay="400") SẢN PHẨM THIÊN NHIÊN HỮU CƠ CHĂM SÓC CÁ NHÂN AN TOÀN, LÀNH TÍNH
                    p.tt(data-aos="fade-up-cus" data-aos-delay="500") 
                        |Câu chuyện thương hiệu
                        +img("bio-health-text.svg")
                    .mona-content(data-aos="fade-up-cus" data-aos-delay="600") 
                        p BioHealth là hành trình tìm lại sự tự nhiên và khỏe mạnh trong từng sản phẩm, bắt đầu từ những nguồn dược liệu Việt Nam tinh túy, được trồng trọt và thu hoạch cẩn trọng từ các vùng nguyên liệu sạch. Trên nền tảng ấy, BioHealth chọn lọc bổ sung những thảo dược quý giá từ khắp nơi trên thế giới – từ châu Á, châu Âu, châu Mỹ đến châu Úc – nơi có điều kiện tự nhiên và tiêu chuẩn canh tác nghiêm ngặt. Ở mỗi nguồn nguyên liệu, BioHealth tìm kiếm không chỉ chất lượng vượt trội, mà còn giá trị bền vững và sự hòa hợp giữa con người với thiên nhiên.

                        p Kết hợp cùng công nghệ chiết xuất hiện đại và quy trình nghiên cứu khoa học tiên tiến, BioHealth mang đến những sản phẩm hiệu quả, an toàn và lành tính cho sức khỏe, đồng thời thân thiện với môi trường.

                        p Sự khác biệt của BioHealth chính là việc thương hiệu không chạy theo xu hướng, mà đi theo con đường bền vững lâu dài. Mỗi sản phẩm không chỉ giúp làn da, mái tóc, răng miệng người sử dụng khỏe mạnh, mà còn là một phần của sứ mệnh lớn lao – bảo vệ sức khỏe cộng đồng và góp phần bảo vệ trái đất. Sự kết hợp hoàn hảo giữa nguyên liệu thiên nhiên và công nghệ xanh giúp tạo ra sản phẩm có chất lượng vượt trội, mang lại cảm giác an tâm khi sử dụng.

                        p Câu chuyện của BioHealth là câu chuyện của những phụ nữ hiện đại, những ng
                    +Btn("Mua sắm ngay hôm nay","","second center","ic-arrow.svg")
    section.sec-ab-tnsm 
        .ab-tnsm.ss-pd-min-t
            .container 
                .ab-tnsm__flex.row 
                    .ab-tnsm__left.col
                        .wrapper 
                            .ab-tnsm__cls
                                .ab-tnsm__cls-item(data-aos="fade-left-cus" data-aos-delay="300")
                                    .ab-tnsm__cls-head
                                        span.txt tầm nhìn
                                    .ab-tnsm__cls-body 
                                        .mona-content
                                            p Bằng giải pháp sử dụng nguồn nguyên liệu tươi nguyên 100%, ứng dụng công nghệ trích ly xanh nhằm đảm bảo phẩm chất hữu cơ đạt hiệu quả chất lượng cao. Quá trình sản xuất từ nguyên liệu được thu hoạch tươi xanh, chiết tách & phối trộn thành phẩm hoàn chỉnh theo tiêu chuẩn khu công nghệ cao TP HCM - SHTP theo tiêu chuẩn cGMP - Asean, đạt chứng nhận ISO & FDA. Cam kết không sử dụng thành phần dược liệu công nghiệp và hương liệu.
                                            p BioHealth mong muốn rằng, mỗi sản phẩm hữu cơ 
                                                strong LIỆU THIÊN NHIÊN 
                                                |quý giá không chỉ mang lại hiệu quả 
                                                strong HỒI PHỤC 
                                                |các tổn hại đã xảy ra theo thời gian mà còn là người bạn đồng hành tin cậy với giải pháp 
                                                strong CHUYỂN ĐỔI HỮU CƠ 
                                                |thiên nhiên, giải pháp cho tinh thần thư thái, tự tin, thoải mái, 
                                                strong SỐNG KHOẺ KHÔNG DÙNG THUỐC.
                                .ab-tnsm__cls-item(data-aos="fade-left-cus" data-aos-delay="600")
                                    .ab-tnsm__cls-head
                                        span.txt Sứ mệnh
                                    .ab-tnsm__cls-body
                                        .mona-content
                                            p Việt Nam sở hữu những vùng nguyên liệu dược liệu phong phú trải dài khắp đất nước. Đây là lợi thế lớn của Việt Nam khi thế giới ngày càng chuyển đổi xanh sử dụng dược liệu thảo mộc. 
                                            p Chúng tôi cảm thấy tự hào khi có thể giúp nâng cao giá trị sử dụng và giá trị kinh tế của những nguyên liệu dược liệu dân gian, nguồn tài nguyên dồi dào và tái sinh. Chúng tôi mong muốn tạo ra các sản phẩm có giá trị kinh tế cao trong ngành dược liệu hóa phẩm. 
                                            strong “BioHealth mong muốn trở thành người bạn đồng hành, cùng bạn trên hành trình chuyển đổi xanh nâng tầm chất lượng cuộc sống, cho môi trường sống ngày càng tươi đẹp hơn”.
                    .ab-tnsm__right.col 
                        .wrapper
                            .ab-tnsm__img.hoverParas 
                                .img-decs
                                    each val,index in Array(4) 
                                        .img-dec.hoverParasIt 
                                            +img(`ab-tnsm-dec${index+1}.png`)
                                .img 
                                    +img("ab-tnsm-vn.png")
    section.sec-ab-three 
        .ab-three.ss-pd-min-t
            .container 
                h2.ab-three__title(data-aos="fade-up-cus" data-aos-delay="300") 
                    |KHÁC BIỆT TỪ BIOHEALTH
                    +img("bio-health-text.svg")
                .ab-three__flex.row 
                    -
                        var arrs = [
                            {
                                icon:"diff1.png",
                                tt:" 100% thảo dược tươi nguyên – Thật sự thiên nhiên",
                            },
                            {
                                icon:"diff2.png",
                                tt:" Công nghệ trích ly xanh – Giữ nguyên phẩm chất, loại bỏ tạp chất",
                            },
                            {
                                icon:"diff3.png",
                                tt:"Sự khác biệt của BioHealth trong dòng sản phẩm vệ sinh & chăm sóc cá nhân",
                            },
                        ]
                    each val,index in arrs 
                        .ab-three__item.col 
                            .inner 
                                .icon 
                                    +img(val.icon)
                                .tt=val.tt
                                p.des Không giống nhiều sản phẩm trên thị trường sử dụng nguyên liệu khô hoặc chiết xuất tổng hợp, quá trình sản xuất BioHealth bắt đầu từ nguồn dược liệu tươi nguyên. Mỗi thành phần như lá trầu không, gừng, bồ hòn, rau má, xương rồng tai thỏ… đều được thu hoạch trực tiếp từ vùng nguyên liệu sạch, đảm bảo độ tươi mới và hàm lượng hoạt chất cao nhất.
    section.sec-ab-care 
        .ab-care.ss-pd-min-t 
            .container 
                +headVerti("mb-24 center")
                    +title40("MỸ PHẨM DƯỢC LIỆU HỮU CƠ THIÊN NHIÊN, LÀM SẠCH, CHĂM SÓC VỆ SINH CƠ THỂ","add-class text-hori","true")
                .ab-care__flex.row 
                    .ab-care__left.col 
                        .wrapper 
                            .ab-care__item(data-aos="fade-left-cus" data-aos-delay="300") 
                                .inner 
                                    .icon 
                                        +img("icon-care1.png")
                                    .content 
                                        h4.content-tt Ứng dụng khoa học dược liệu – Thành phần hoạt tính chủ động từ thiên nhiên
                                        p.content-des BioHealth kế thừa và phát triển các bài thuốc dân gian từ lá trầu không, gừng, bồ hòn, rau má, xương rồng tai thỏ…, kết hợp với khoa học dược liệu hiện đại để tối ưu hiệu quả, ứng dụng làm sạch, vệ sinh chăm sóc cá nhân thay thế sản phẩm hoá chất.
                            .ab-care__item(data-aos="fade-left-cus" data-aos-delay="500") 
                                .inner 
                                    .icon 
                                        +img("icon-care2.png")
                                    .content 
                                        h4.content-tt Công nghệ trích ly xanh – Giữ nguyên dưỡng chất, loại bỏ tạp chất
                                        p.content-des Ứng dụng công nghệ trích ly xanh hiện đại, BioHealth giúp tách chiết tinh khiết các hoạt chất có lợi mà không làm biến đổi dược tính, đồng thời loại bỏ hoàn toàn tạp chất, dư lượng hóa học mà phương pháp thông thường không kiểm soát được. Quy trình này giúp sản phẩm ổn định, an toàn và đạt hiệu quả tối ưu, đáp ứng tiêu chuẩn khắt khe về dược liệu thiên nhiên.
                            .ab-care__item(data-aos="fade-left-cus" data-aos-delay="700") 
                                .inner 
                                    .icon 
                                        +img("icon-care3.png")
                                    .content 
                                        h4.content-tt Sản xuất theo tiêu chuẩn cGMP ASEAN – Quy trình sản xuất và chất lượng sản phẩm được kiểm soát nghiêm ngặt
                                        p.content-des Mỗi sản phẩm BioHealth được sản xuất trên dây chuyền công nghệ cao đạt chuẩn ISO, đảm bảo độ tinh khiết, an toàn sinh học và ổn định trong suốt vòng đời sản phẩm.
                    .ab-care__right.col 
                        .wrapper
                            .ab-tnsm__img.hoverParas 
                                .img-decs
                                    each val,index in Array(4) 
                                        .img-dec.hoverParasIt 
                                            +img(`ab-tnsm-img${index+1}.png`)
                                .img 
                                    +img("ab-tnsm-img.png")
    section.sec-ab-why 
        .ab-why.ss-pd-min-t 
            .container 
                h2.ab-three__title 
                    |tại sao nên lựa chọn
                    +img("bio-health-text.svg")
                .ab-why__table 
                    table 
                        thead 
                            tr
                                th Tiêu chí
                                th BioHealth – Dược liệu hữu cơ 100% thiên nhiên
                                th Mỹ phẩm thiên nhiên/ bán hữu cơ
                        tbody 
                            tr 
                                td Nguồn nguyên liệu
                                td Quy trình sản xuất từ dược liệu tươi 100%, giữ trọn dưỡng chất tự nhiên.
                                td Phối trộn Dược liệu cô đặc, có thể đã qua xử lý hóa học hoặc không rõ nguồn gốc dược liệu
                            tr 
                                td Phương pháp chiết xuất
                                td Công nghệ trích ly xanh, giữ tối đa dưỡng chất, không dung môi hóa học mạnh.
                                td Chiết xuất công nghiệp truyền thống, có nguy cơ tồn dư dung môi hóa học.
                            tr 
                                td Độ an toàn
                                td Không hóa chất độc hại, không hương liệu, phẩm màu tổng hợp, an toàn cho da nhạy cảm.
                                td Có thể chứa chất bảo quản, hương liệu tổng hợp, dễ gây kích ứng, ảnh hưởng nội tiết tố
                            tr 
                                td Công dụng & hiệu quả
                                td Nuôi dưỡng & phục hồi tự nhiên, không gây mất cân bằng sinh lý da.
                                td Hiệu quả nhanh nhưng có nguy cơ kích ứng, mất cân bằng da. & PHỤ THUỘC HOÁ CHẤT
                            tr 
                                td Quy trình sản xuất
                                td Theo tiêu chuẩn cGMP ASEAN, không chất bảo quản tổng hợp mạnh.
                                td Mỹ phẩm công nghiệp, có thể dùng phụ gia bảo quản.
                            tr 
                                td Tính bền vững
                                td Thân thiện môi trường, không thử nghiệm trên động vật.
                                td Có thể gây ô nhiễm môi trường do dư lượng hóa chất.
    section.sec-ab-commit 
        .ab-commit.ss-pd-min-t 
            .container 
                h2.ab-three__title 
                    |cam kết từ
                    +img("bio-health-text.svg")
                .ab-commit__slide 
                    .swiper.row.gap-res 
                        .swiper-wrapper 
                            each val,index in Array(3)
                                .swiper-slide.col 
                                    .ab-commit__item 
                                        .inner 
                                            .img 
                                                .img-inner 
                                                    +img(`commit${index+1}.png`)
                                            .info 
                                                h4 
                                                    a(href="").info-tt  Sử dụng 100% Dược liệu tươi nguyên 
                                                p.info-des Ứng dụng công nghệ trích ly xanh để giữ trọn tinh túy thiên nhiên.
                    +Pagination
    section.sec-ab-brand 
        .ab-brand.ss-pd-t 
            .container 
                .ab-brand__box 
                    +headVerti("center mb-24")
                        +title40("Thương hiệu đối tác")
                    -
                        var brands = [
                            {
                                img:"brand1.png",
                            },
                            {
                                img:"brand2.png",
                            },
                            {
                                img:"brand3.png",
                            },
                            {
                                img:"brand4.png",
                            },
                            {
                                img:"brand5.png",
                            },
                        ]
                    +LogoSplide(brands)

    +secSale